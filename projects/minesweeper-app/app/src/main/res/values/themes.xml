<?xml version="1.0" encoding="utf-8"?>
<!--
  The launch window theme. It styles exactly one thing: the window the system shows
  between the tap on the icon and the first Compose frame. Every pixel after that comes
  from NothingTheme.

  `windowBackground` is set because the platform default is white. Launching into a white
  window and then repainting to #000000 reads as a flash on every cold start, which is
  precisely the kind of unpolished seam this design language exists to avoid.

  Bar colours are deliberately absent: enableEdgeToEdge sets them at runtime from the
  app's own theme setting, which the system cannot know. See MainActivity.
-->
<resources>
    <style name="Theme.NothingGames" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
